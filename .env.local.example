# Copy this file to .env.local and add your OpenAI API key.
OPENAI_API_KEY=
# Optional: enables the agents' read-only web search tool.
BRAVE_SEARCH_API_KEY=
# Build the image with: docker build -t humane-agent-computer:latest docker/agent-computer
# Browser calls require a Docker network that only permits controlled public-web egress.
HUMANE_COMPUTER_IMAGE=humane-agent-computer:latest
HUMANE_COMPUTER_NETWORK=
# Optional for a non-standard host user mapping; defaults to the Rails process user.
HUMANE_COMPUTER_USER=
