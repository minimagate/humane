<%= form_with model: [ @agent, skill ], url: skill.persisted? ? agent_skill_path(@agent, skill.name) : agent_skills_path(@agent), class: "mx-auto w-full max-w-2xl space-y-4" do |form| %>
  <% if skill.errors.any? %>
    <div class="rounded-field bg-danger-surface px-3 py-2.5 text-sm text-danger"><%= skill.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1.5 block text-sm font-medium text-ink" %>
    <%= form.text_field :name, disabled: skill.persisted?, placeholder: "e.g. web-research", class: "w-full rounded-field bg-muted px-3 py-2.5 text-sm text-ink outline-none placeholder:text-faint disabled:text-faint focus:ring-2 focus:ring-focus" %>
    <p class="mt-2 text-xs leading-5 text-secondary">Lowercase letters, numbers, and hyphens. Pi uses this as the skill command name.</p>
  </div>

  <div>
    <%= form.label :description, class: "mb-1.5 block text-sm font-medium text-ink" %>
    <%= form.text_area :description, rows: 2, placeholder: "When should this skill be used?", class: "w-full resize-none rounded-field bg-muted px-3 py-2.5 text-sm leading-6 text-ink outline-none placeholder:text-faint focus:ring-2 focus:ring-focus" %>
  </div>

  <div>
    <%= form.label :instructions, "SKILL.md", class: "mb-1.5 block text-sm font-medium text-ink" %>
    <%= form.text_area :instructions, rows: 11, spellcheck: false, class: "w-full resize-y rounded-field bg-muted px-3 py-2.5 text-sm leading-6 text-ink outline-none placeholder:text-faint focus:ring-2 focus:ring-focus" %>
  </div>

  <div class="flex justify-end">
    <%= form.submit skill.persisted? ? "Save skill" : "Create skill", class: "rounded-field bg-ink px-3.5 py-2 text-sm font-medium text-canvas transition hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" %>
  </div>
<% end %>
