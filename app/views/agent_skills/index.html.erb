<% content_for :title, "#{@agent.name}'s skills — Humane" %>

<div class="flex min-h-dvh bg-canvas">
  <%= render "agents/sidebar", display: "hidden sm:flex" %>
  <section class="min-w-0 flex-1">
    <header class="flex h-14 items-center justify-between px-5 sm:px-6">
      <div><h1 class="text-sm font-semibold tracking-[-0.015em] text-ink">Skills</h1><p class="text-xs text-secondary"><%= @agent.name %></p></div>
      <%= link_to "New skill", new_agent_skill_path(@agent), class: "rounded-full bg-ink px-3.5 py-2 text-sm font-medium text-canvas transition hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" %>
    </header>
    <div class="mx-auto max-w-2xl px-5 py-5 sm:px-6 sm:py-6">
      <% if @skills.any? %>
        <div class="space-y-1.5">
          <% @skills.each do |skill| %>
            <%= link_to edit_agent_skill_path(@agent, skill.name), class: "block rounded-field px-3 py-3 transition hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" do %>
              <p class="text-sm font-medium text-ink"><%= skill.name %></p>
              <p class="mt-1 text-sm leading-6 text-secondary"><%= skill.description %></p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="py-20 text-center"><p class="text-sm font-medium text-ink">No skills yet</p><p class="mt-2 text-sm text-secondary">Skills give <%= @agent.name %> specialized, reusable instructions.</p></div>
      <% end %>
    </div>
  </section>
</div>
