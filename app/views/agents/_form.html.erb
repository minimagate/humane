<% condensed = local_assigns.fetch(:condensed, false) %>

<%= form_with model: agent, class: "mx-auto w-full max-w-2xl space-y-4" do |form| %>
  <% if agent.errors.any? %>
    <div class="rounded-field bg-danger-surface px-3 py-2.5 text-sm text-danger"><%= agent.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :name, class: "mb-1.5 block text-sm font-medium text-ink" %>
      <%= form.text_field :name, autofocus: true, placeholder: "e.g. Ada", class: "w-full rounded-field bg-muted px-3 py-2.5 text-sm text-ink outline-none placeholder:text-faint focus:ring-2 focus:ring-focus" %>
    </div>
    <div>
      <%= form.label :role, class: "mb-1.5 block text-sm font-medium text-ink" %>
      <%= form.text_field :role, placeholder: "e.g. Researcher", class: "w-full rounded-field bg-muted px-3 py-2.5 text-sm text-ink outline-none placeholder:text-faint focus:ring-2 focus:ring-focus" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "mb-1.5 block text-sm font-medium text-ink" %>
    <%= form.text_area :description, rows: 2, placeholder: "What is this teammate especially good at?", class: "w-full resize-none rounded-field bg-muted px-3 py-2.5 text-sm leading-6 text-ink outline-none placeholder:text-faint focus:ring-2 focus:ring-focus" %>
  </div>

  <div>
    <div class="mb-1.5 flex items-center justify-between">
      <%= form.label :system_prompt, "AGENTS.md", class: "block text-sm font-medium text-ink" %>
      <span class="text-xs text-secondary">System instructions</span>
    </div>
    <%= form.text_area :system_prompt, rows: condensed ? 7 : 9, spellcheck: false, class: "w-full resize-y rounded-field bg-muted px-3 py-2.5 text-sm leading-6 text-ink outline-none placeholder:text-faint focus:ring-2 focus:ring-focus" %>
  </div>

  <div class="flex justify-end">
    <%= form.submit agent.persisted? ? "Save agent" : "Create agent", class: "rounded-field bg-ink px-3.5 py-2 text-sm font-medium text-canvas transition hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" %>
  </div>
<% end %>
