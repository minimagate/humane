<% content_for :title, "Humane — your AI team" %>

<div class="flex min-h-dvh bg-canvas">
  <%= render "sidebar" %>
  <section class="hidden min-w-0 flex-1 flex-col sm:flex">
    <div class="flex flex-1 items-center justify-center px-5">
      <div class="max-w-xs text-center">
        <p class="text-base font-medium tracking-[-0.025em] text-ink">Your team lives here</p>
        <p class="mt-2 text-sm leading-6 text-secondary">Choose an agent to continue a conversation, or create someone new.</p>
      </div>
    </div>
  </section>

  <%= render "create_modal", agent: @agent, open: @show_agent_modal %>
</div>
