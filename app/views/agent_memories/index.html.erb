<% content_for :title, "#{@agent.name}'s memories — Humane" %>

<div class="flex min-h-dvh bg-canvas">
  <%= render "agents/sidebar", display: "hidden sm:flex" %>
  <section class="min-w-0 flex-1">
    <header class="flex h-14 items-center justify-between px-5 sm:px-6">
      <div>
        <h1 class="text-sm font-semibold tracking-[-0.015em] text-ink">Memories</h1>
        <p class="text-xs text-secondary"><%= @agent.name %></p>
      </div>
      <%= link_to "Agent", edit_agent_path(@agent), class: "rounded-full px-3 py-1.5 text-sm text-secondary transition hover:bg-muted hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" %>
    </header>

    <div class="mx-auto max-w-2xl px-5 py-5 sm:px-6 sm:py-6">
      <% if @memories.any? %>
        <div class="space-y-2">
          <% @memories.each do |memory| %>
            <article class="rounded-panel bg-muted px-4 py-3.5">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm leading-6 text-ink"><%= memory.content %></p>
                  <p class="mt-1 text-xs text-secondary"><%= memory.kind.humanize %> · priority <%= memory.priority %>/5 · confidence <%= number_to_percentage(memory.confidence * 100, precision: 0) %> · <%= memory.status %></p>
                </div>
                <%= button_to "Forget", agent_memory_path(@agent, memory), method: :delete, class: "shrink-0 rounded-field px-2.5 py-1.5 text-xs text-secondary transition hover:bg-danger-surface hover:text-danger focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus" %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="py-20 text-center">
          <p class="text-sm font-medium text-ink">No memories yet</p>
          <p class="mt-2 text-sm text-secondary">Important, durable details from <%= @agent.name %>'s conversations will appear here.</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
