<article id="<%= dom_id(message) %>" class="flex <%= message.user? ? "justify-end" : "justify-start" %>">
  <div class="max-w-[min(42rem,85%)] rounded-2xl px-4 py-3 text-sm leading-6 <%= message.user? ? "rounded-br-md bg-white text-zinc-900" : "rounded-bl-md bg-white/[0.07] text-zinc-200" %>">
    <%= simple_format(message.content, {}, wrapper_tag: "div") %>
  </div>
</article>
